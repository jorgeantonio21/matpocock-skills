+/// Error returned when text or an integer cannot be converted into a `Limit`.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub enum ParseLimitError {
+    /// The input was not a valid `u8`.
+    Int(ParseIntError),
+    /// The input was a valid `u8` but exceeds `Limit::MAX`.
+    OutOfRange(u8),
+}
+
+impl fmt::Display for ParseLimitError {
+    fn fmt(&self, f: &mut fmt::Formatter<'_>) -> fmt::Result {
+        match self {
+            Self::Int(err) => write!(f, "invalid limit: {err}"),
+            Self::OutOfRange(value) => {
+                write!(f, "limit {value} is out of range 0..={}", Limit::MAX)
+            }
+        }
+    }
+}
+
+impl std::error::Error for ParseLimitError {
+    fn source(&self) -> Option<&(dyn std::error::Error + 'static)> {
+        match self {
+            Self::Int(err) => Some(err),
+            Self::OutOfRange(_) => None,
+        }
+    }
+}
+
+impl From<ParseIntError> for ParseLimitError {
+    fn from(err: ParseIntError) -> Self {
+        Self::Int(err)
+    }
+}
+
+impl TryFrom<u8> for Limit {
+    type Error = ParseLimitError;
+
+    fn try_from(value: u8) -> Result<Self, Self::Error> {
+        Self::new(value).ok_or(ParseLimitError::OutOfRange(value))
+    }
+}
